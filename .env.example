# Choose one provider: nvidia | gemini | openai
RBWS_LLM_PROVIDER=nvidia

# --- NVIDIA NIM (OpenAI-compatible) ---
NVIDIA_API_KEY=your-nvidia-api-key-here
# Must be a VISION model for scanned PDFs
NVIDIA_MODEL=nvidia/nemotron-nano-12b-v2-vl

# --- Gemini ---
# RBWS_LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-flash-latest

# --- OpenAI ---
# RBWS_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4.1

RBWS_EXTRACTION_MODE=auto
RBWS_MIN_TEXT_CHARS=80
RBWS_MIN_TEXT_WORDS=12
RBWS_LOG_LEVEL=INFO
RBWS_RENDER_DPI=200
RBWS_MAX_PAGES=0
